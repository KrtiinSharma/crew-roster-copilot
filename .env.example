# Which LLM answers chat: auto (Claude if ANTHROPIC_API_KEY is set, else Groq) | anthropic | groq
LLM_PROVIDER=auto
# Claude (key: https://console.anthropic.com -> API Keys); also used by the eval judge
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
ANSWER_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
# rewrite change explanations with the LLM (numbers are checked; templates otherwise)
LLM_EXPLANATIONS=true

# LangSmith tracing (free key: https://smith.langchain.com -> Settings -> API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=crew-roster-copilot

# Optional Claude judge for the agent eval (crew-eval agent --judge; costs a few cents)
JUDGE_MODEL=claude-haiku-5-5

# API
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=10
SOLVE_TIME_LIMIT=10
